  "measures": [
    {
      "id": "totalEmployees",
      "title": "Всего сотрудников",
      "formula": "Count(DISTINCT [Сотрудник])"
    },
    {
      "id": "totalTeams",
      "title": "Всего команд",
      "formula": "Count(DISTINCT [Команда])"
    },
    {
      "id": "avgTeamSize",
      "title": "Средний размер команды",
      "formula": "Count(DISTINCT [Сотрудник]) / Count(DISTINCT [Команда])"
    },
    {
      "id": "employeesWithoutTeam",
      "title": "Сотрудники без команды",
      "formula": "Count(DISTINCT {<[Команда]={'null'}>} [Сотрудник])"
    }
  ],
  "dimensions": [
    {
      "id": "dimTeam",
      "title": "Команда",
      "field": "Команда"
    },
    {
      "id": "dimEmployee",
      "title": "Сотрудник",
      "field": "Сотрудник"
    },
    {
      "id": "dimEmployeeID",
      "title": "ID сотрудника",
      "field": "employeeID"
    }
  ],
  "sheets": [
    {
      "title": "Обзор",
      "objects": [
        {
          "type": "kpi",
          "title": "Всего сотрудников",
          "measure": "totalEmployees",
          "col": 4,
          "row": 0,
          "colspan": 4,
          "rowspan": 3
        },
        {
          "type": "kpi",
          "title": "Всего команд",
          "measure": "totalTeams",
          "col": 8,
          "row": 0,
          "colspan": 4,
          "rowspan": 3
        },
        {
          "type": "kpi",
          "title": "Средний размер команды",
          "measure": "avgTeamSize",
          "col": 12,
          "row": 0,
          "colspan": 4,
          "rowspan": 3
        },
        {
          "type": "kpi",
          "title": "Сотрудники без команды",
          "measure": "employeesWithoutTeam",
          "col": 16,
          "row": 0,
          "colspan": 4,
          "rowspan": 3
        },
        {
          "type": "listbox",
          "title": "Команда",
