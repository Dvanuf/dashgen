            "totalEmployees"
          ],
          "col": 4,
          "row": 3,
          "colspan": 16,
          "rowspan": 4
        },
        {
          "type": "table",
          "title": "Детализация команда-сотрудник",
          "dimensions": [
            "dimTeam",
            "dimEmployee",
            "dimEmployeeID"
          ],
          "measures": [
            "totalEmployees"
          ],
          "col": 4,
          "row": 7,
          "colspan": 19,
          "rowspan": 5
        }
      ]
    }
  ]
