{
  "name": "dashgen",
  "version": "0.5.1",
  "description": "Сборка дашбордов Qlik Sense из Excel с ИИ",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "build": "node cli.js build examples/spec-sales-inline.json",
    "check": "node cli.js check examples/spec-sales-inline.json",
    "ui": "node server.js",
    "app": "electron desktop/main.js",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "enigma.js": "^2.15.0",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ru.itgri.dashgen",
    "productName": "Dashgen",
    "directories": {
      "buildResources": "desktop/build",
      "output": "dist"
    },
    "files": [
      "server.js",
      "cli.js",
      "src/**",
      "public/**",
      "spec/**",
      "examples/**",
      "desktop/**",
      "templates/**",
      "config.json",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "icon": "desktop/build/icon.png",
      "category": "public.app-category.business",
      "identity": null
    }
  }
}
