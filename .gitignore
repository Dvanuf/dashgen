# Сертификаты Qlik и ключи — никогда не попадают в git
certs/
*.pem
*.p12
*.pfx
*.zip

# Секреты и окружение
.env
.env.*
*.key
config.json

# Журналы отправок в ИИ и сборок (хранятся только локально)
logs/
*.log

# Зависимости
node_modules/

# Временные файлы Office и системы
~$*
.DS_Store
Thumbs.db

# Рабочие артефакты сборки
output/
*.qvf~

# Временные файлы локального сервера
tmp/

# Ключи ИИ-провайдеров (вне git)
*.api_key

# Сборка приложения
dist/
