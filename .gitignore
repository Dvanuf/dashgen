# Сертификаты Qlik и ключи — никогда не попадают в git
certs/
*.pem
*.p12
*.pfx
*.zip

# Секреты и окружение
.env
.env.*
*.key

# Журналы отправок в ИИ и сборок (хранятся только локально)
logs/
*.log

# Зависимости
node_modules/

# Временные файлы Office и системы
~$*
.DS_Store
Thumbs.db

# Рабочие артефакты сборки
output/
*.qvf~
